@* A reusable pager. It only needs numbers and the current filters, so any list page can use it:
   <partial name="_Pager" model="Model.Pager" />
   asp-all-route-data builds ?search=...&page=N from a dictionary, so filters survive page changes. *@
@model CarService.Web.ViewModels.PagerViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages" class="d-flex align-items-center gap-3">
        <ul class="pagination mb-0">
            @* A disabled button is a plain <span>, not a link: nothing to click, nothing for a crawler to follow. *@
            @if (Model.Page > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(Model.Page - 1)">Previous</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Previous</span></li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(Model.Page + 1)">Next</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Next</span></li>
            }
        </ul>
        <span class="text-muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount results)</span>
    </nav>
}
else
{
    <span class="text-muted">@Model.TotalCount result@(Model.TotalCount == 1 ? "" : "s")</span>
}
