@model CarService.Web.ViewModels.VehicleFormViewModel
@{
    ViewData["Title"] = "Add vehicle";
}

<h1>Add vehicle</h1>

@* Tag helpers (asp-*) are HTML attributes that Razor turns into real attributes:
   asp-action builds the URL, <form> gets the anti-forgery token, asp-for wires
   an input to a model property (name, id, value, validation attributes). *@
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Vin" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Vin" class="form-control text-uppercase" maxlength="17" autocomplete="off" />
            <button type="button" id="vin-lookup" class="btn btn-outline-secondary">Look up VIN</button>
        </div>
        <span asp-validation-for="Vin" class="text-danger"></span>
        <div id="vin-message" class="form-text" role="status"></div>
    </div>
    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LicensePlate" class="form-label"></label>
        <input asp-for="LicensePlate" class="form-control" />
        <span asp-validation-for="LicensePlate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label"></label>
        @* asp-items renders one <option> per SelectListItem and marks the current CustomerId
           as selected, so the choice survives a redisplay after a validation error. *@
        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
            <option value="0">-- select owner --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
        @if (!Model.Customers.Any())
        {
            <div class="form-text">No customers yet. <a asp-controller="Customers" asp-action="Create">Add one first</a>.</div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @* Client-side validation scripts, shipped with the MVC template *@
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Progressive enhancement: the form works without this script (type the details by hand);
        // the script only adds the convenience of auto-filling them.
        const lookupUrl = '@Url.Action("DecodeVin", "Vehicles")';   // generated server-side, so it follows the routing config
        const button = document.getElementById('vin-lookup');
        const message = document.getElementById('vin-message');

        button.addEventListener('click', async () => {
            const vin = document.getElementById('Vin').value.trim();
            if (!vin) { message.textContent = 'Enter a VIN first.'; return; }

            button.disabled = true;
            message.className = 'form-text';
            message.textContent = 'Looking up...';
            try {
                const response = await fetch(`${lookupUrl}?vin=${encodeURIComponent(vin)}`);
                const result = await response.json();
                if (result.succeeded) {
                    document.getElementById('Make').value = result.make;
                    if (result.year) document.getElementById('Year').value = result.year;
                    // Partial result (common outside the US): leave Model for the user and put the cursor there.
                    if (result.model) document.getElementById('Model').value = result.model;
                    else document.getElementById('Model').focus();
                }
                // textContent (not innerHTML): the message is never interpreted as HTML (XSS-safe).
                message.textContent = result.succeeded
                    ? (result.message ?? 'Details filled in. Please check them.')
                    : result.message;
                message.className = result.succeeded ? 'form-text text-success' : 'form-text text-danger';
            } catch {
                message.textContent = 'Could not reach the server. Enter the details manually.';
                message.className = 'form-text text-danger';
            } finally {
                button.disabled = false;
            }
        });
    </script>
}
