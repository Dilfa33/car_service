@model CarService.Web.ViewModels.ListViewModel<CarService.Core.Entities.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

<h1>Vehicles</h1>
<p><a asp-action="Create" class="btn btn-primary">Add vehicle</a></p>

<partial name="_SearchBox" model="Model.Search" />

<div class="table-responsive">
<table class="table">
    <thead>
        <tr><th>Make</th><th>Model</th><th>Year</th><th>Plate</th><th>VIN</th><th>Owner</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var v in Model.Result.Items)
    {
        <tr>
            <td>@v.Make</td>
            <td>@v.Model</td>
            <td>@v.Year</td>
            <td>@v.LicensePlate</td>
            <td>@v.Vin</td>
            <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@v.CustomerId">@v.Customer?.FullName</a></td>
            <td><a asp-controller="Appointments" asp-action="Create" asp-route-vehicleId="@v.Id">Book</a></td>
        </tr>
    }
    </tbody>
</table>
</div>

<partial name="_Pager" model="Model.Pager" />
