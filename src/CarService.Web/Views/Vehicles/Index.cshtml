@* Razor = HTML + C#. `@model` declares the type this view receives from the controller.
   It's strongly typed, so mistakes are compile errors, not runtime surprises. *@
@model IEnumerable<CarService.Core.Entities.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<h1>Vehicles</h1>
<p><a asp-action="Create" class="btn btn-primary">Add vehicle</a></p>

<table class="table">
    <thead>
        <tr><th>Make</th><th>Model</th><th>Year</th><th>Plate</th><th>Owner</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Make</td>   @* @ outputs HTML-encoded text - protects against XSS *@
            <td>@v.Model</td>
            <td>@v.Year</td>
            <td>@v.LicensePlate</td>
            <td>@v.Customer?.FullName</td>
            <td><a asp-controller="Appointments" asp-action="Create" asp-route-vehicleId="@v.Id">Book</a></td>
        </tr>
    }
    </tbody>
</table>
