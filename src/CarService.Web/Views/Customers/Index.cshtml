@model CarService.Web.ViewModels.ListViewModel<CarService.Core.Entities.Customer>
@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>
<p><a asp-action="Create" class="btn btn-primary">Add customer</a></p>

<partial name="_SearchBox" model="Model.Search" />

<div class="table-responsive">
<table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Result.Items)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@c.Id">@c.FullName</a></td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>
                <a asp-action="Details" asp-route-id="@c.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@c.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<partial name="_Pager" model="Model.Pager" />
