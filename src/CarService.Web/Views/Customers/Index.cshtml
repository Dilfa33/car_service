@model IEnumerable<CarService.Core.Entities.Customer>
@{
    ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p><a asp-action="Create" class="btn btn-primary">Add customer</a></p>

<table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.FullName</td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>
                @* asp-route-id fills the {id} part of the URL: /Customers/Edit/5 *@
                <a asp-action="Edit" asp-route-id="@c.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
