@model CarService.Core.Entities.ServiceAppointment
@{
    ViewData["Title"] = "Appointment";
}

<h1>Appointment <partial name="_StatusBadge" model="Model.Status" /></h1>

<dl class="row">
    <dt class="col-sm-2">Vehicle</dt>
    <dd class="col-sm-10">@Model.Vehicle?.Make @Model.Vehicle?.Model (@Model.Vehicle?.LicensePlate)</dd>
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Vehicle?.Customer?.FullName</dd>
    <dt class="col-sm-2">When</dt>
    <dd class="col-sm-10">@Model.ScheduledAt.ToString("f")</dd>
    <dt class="col-sm-2">Work</dt>
    <dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Cost</dt>
    <dd class="col-sm-10">@(Model.Cost?.ToString("C") ?? "-")</dd>
</dl>

@* Only show the status form while a next step exists. The list of choices comes from the
   entity's own rule (AllowedNextStatuses), so the UI can never offer an illegal move. *@
@if (Model.AllowedNextStatuses.Any())
{
    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label" for="newStatus">Move to</label>
            <select id="newStatus" name="newStatus" class="form-select"
                    asp-items="@(new SelectList(Model.AllowedNextStatuses))"></select>
        </div>
        <div class="col-auto">
            <label class="form-label" for="cost">Final cost (needed to complete)</label>
            <input id="cost" name="cost" type="number" step="0.01" min="0" class="form-control" value="@Model.Cost" />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Update status</button></div>
    </form>
}

@if (!Model.IsClosed)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
}
<a asp-action="Index" class="btn btn-secondary">Back to list</a>
